rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  function article(id) { return exists(/databases/$(database)/documents/articles/$(id)); }
  function commentValid(d) {
   return d.author is string && d.author.size() > 0 && d.author.size() <= 80
    && d.body is string && d.body.size() > 0 && d.body.size() <= 2500;
  }
  match /admins/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow write, list: if false; }
  match /articles/{slug} {
   allow read: if true;
   allow write: if admin();
   match /likes/{uid} {
    allow read: if article(slug);
    allow create: if article(slug) && signedIn() && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    allow delete: if signedIn() && request.auth.uid == uid;
    allow update: if false;
   }
   match /comments/{id} {
    allow read: if article(slug);
    allow create, update: if admin() && article(slug) && commentValid(request.resource.data)
     && request.resource.data.keys().hasOnly(['author','body','createdAt']) && request.resource.data.createdAt is timestamp;
    allow delete: if admin();
   }
  }
  match /submissions/{id} {
   allow get: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow list: if admin();
   allow create: if signedIn() && article(request.resource.data.article) && commentValid(request.resource.data)
    && request.resource.data.keys().hasOnly(['uid','article','author','body','createdAt','status'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/commentLimits/$(request.auth.uid)).data.lastAt == request.time
    && getAfter(/databases/$(database)/documents/commentLimits/$(request.auth.uid)).data.lastId == id;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status in ['pending','approved','rejected'];
   allow delete: if admin();
  }
  match /commentLimits/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, delete: if false;
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['lastAt','lastId'])
    && request.resource.data.lastAt == request.time
    && (!exists(/databases/$(database)/documents/commentLimits/$(uid)) || resource.data.lastAt < request.time - duration.value(60,'s'))
    && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.lastId)).data.uid == uid
    && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.lastId)).data.createdAt == request.time;
  }
  match /contactMessages/{id} {
   allow get: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow list: if admin();
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['uid','name','email','subject','message','createdAt','status'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
    && request.resource.data.email is string && request.resource.data.email.size() <= 254
    && request.resource.data.email.matches('[^ @]+@[^ @]+[.][^ @]+')
    && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 180
    && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 8000
    && request.resource.data.createdAt == request.time && request.resource.data.status == 'new'
    && getAfter(/databases/$(database)/documents/contactLimits/$(request.auth.uid)).data.lastAt == request.time
    && getAfter(/databases/$(database)/documents/contactLimits/$(request.auth.uid)).data.lastId == id;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status in ['new','read','archived'];
   allow delete: if false;
  }
  match /contactLimits/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, delete: if false;
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['lastAt','lastId'])
    && request.resource.data.lastAt == request.time
    && (!exists(/databases/$(database)/documents/contactLimits/$(uid)) || resource.data.lastAt < request.time - duration.value(300,'s'))
    && getAfter(/databases/$(database)/documents/contactMessages/$(request.resource.data.lastId)).data.uid == uid
    && getAfter(/databases/$(database)/documents/contactMessages/$(request.resource.data.lastId)).data.createdAt == request.time;
  }

  // Editorial material is accessible only through owner access or a revocable
  // invitation. Invitation secrets and membership tokens are never listable.
  match /editorialProjects/{project} {
   function invitation(id) { return get(/databases/$(database)/documents/editorialProjects/$(project)/invites/$(id)).data; }
   function member() { return get(/databases/$(database)/documents/editorialProjects/$(project)/members/$(request.auth.uid)).data; }
   function activeInvite(id) { return invitation(id).active == true && invitation(id).expiresAt > request.time; }
   function reviewer() {
    return signedIn() && (admin() || (activeInvite(member().inviteId) && member().token == invitation(member().inviteId).token));
   }
   function actor() { return admin() ? request.auth.uid : member().inviteId; }
   function actorName() { return admin() ? 'Ahimanikya' : invitation(member().inviteId).label; }
   allow get: if reviewer();
   allow list: if false;
   allow write: if admin();
   match /invites/{id} {
    allow get: if admin() || (reviewer() && member().inviteId == id);
    allow list, write: if admin();
   }
   match /members/{uid} {
    allow get: if signedIn() && (request.auth.uid == uid || admin());
    allow list: if admin();
    allow create, update: if signedIn() && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['inviteId','token','joinedAt'])
     && request.resource.data.inviteId is string && request.resource.data.token is string
     && request.resource.data.joinedAt == request.time
     && activeInvite(request.resource.data.inviteId)
     && request.resource.data.token == invitation(request.resource.data.inviteId).token;
    allow delete: if admin();
   }
   match /items/{id} { allow read: if reviewer(); allow write: if admin(); }
   match /chapters/{id} { allow read: if reviewer(); allow write: if admin(); }
   match /responses/{id} {
    allow read: if reviewer();
    // Append-only decisions retain both reviewers' work and previous responses.
    // The version binds approval to the exact passage and recommendation.
    allow create: if reviewer()
     && request.resource.data.keys().hasOnly(['itemId','version','reviewerId','reviewerName','status','comment','alternative','createdAt'])
     && request.resource.data.itemId is string
     && request.resource.data.version == get(/databases/$(database)/documents/editorialProjects/$(project)/items/$(request.resource.data.itemId)).data.version
     && request.resource.data.reviewerId == actor() && request.resource.data.reviewerName == actorName()
     && request.resource.data.status in ['approved','suggested','comment','keep','pending']
     && request.resource.data.comment is string && request.resource.data.comment.size() <= 12000
     && request.resource.data.alternative is string && request.resource.data.alternative.size() <= 12000
     && (request.resource.data.status != 'suggested' || request.resource.data.alternative.size() > 0)
     && (request.resource.data.status != 'comment' || request.resource.data.comment.size() > 0)
     && request.resource.data.createdAt == request.time;
    allow update, delete: if false;
   }
  }
 }
}
