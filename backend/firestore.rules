rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  function article(id) { return exists(/databases/$(database)/documents/articles/$(id)); }
  function commentValid(d) {
   return d.author is string && d.author.size() > 0 && d.author.size() <= 80
    && d.body is string && d.body.size() > 0 && d.body.size() <= 2500;
  }
  match /admins/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow write, list: if false; }
  match /articles/{slug} {
   allow read: if true;
   allow write: if admin();
   match /likes/{uid} {
    allow read: if article(slug);
    allow create: if article(slug) && signedIn() && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    allow delete: if signedIn() && request.auth.uid == uid;
    allow update: if false;
   }
   match /comments/{id} {
    allow read: if article(slug);
    allow create, update: if admin() && article(slug) && commentValid(request.resource.data)
     && request.resource.data.keys().hasOnly(['author','body','createdAt']) && request.resource.data.createdAt is timestamp;
    allow delete: if admin();
   }
  }
  match /submissions/{id} {
   allow get: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
   allow list: if admin();
   allow create: if signedIn() && article(request.resource.data.article) && commentValid(request.resource.data)
    && request.resource.data.keys().hasOnly(['uid','article','author','body','createdAt','status'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time
    && getAfter(/databases/$(database)/documents/commentLimits/$(request.auth.uid)).data.lastAt == request.time
    && getAfter(/databases/$(database)/documents/commentLimits/$(request.auth.uid)).data.lastId == id;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status in ['pending','approved','rejected'];
   allow delete: if admin();
  }
  match /commentLimits/{uid} {
   allow get: if signedIn() && request.auth.uid == uid;
   allow list, delete: if false;
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['lastAt','lastId'])
    && request.resource.data.lastAt == request.time
    && (!exists(/databases/$(database)/documents/commentLimits/$(uid)) || resource.data.lastAt < request.time - duration.value(60,'s'))
    && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.lastId)).data.uid == uid
    && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.lastId)).data.createdAt == request.time;
  }
 }
}
